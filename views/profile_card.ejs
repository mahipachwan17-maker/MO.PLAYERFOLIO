<%- include('header') %>
<div class="container" style="max-width:460px">
  <div style="border:4px solid #ff6a00;border-radius:22px;background:linear-gradient(180deg,#1c1c1f,#0b0b0c);padding:18px;box-shadow:0 0 30px rgba(255,106,0,0.25)">
    <div style="display:flex;justify-content:space-between;align-items:flex-start">
      <div>
        <% if (p.jersey) { %><div style="font-size:44px;font-weight:900;color:#ff6a00;line-height:1"><%= p.jersey %></div><% } %>
        <div class="pf-pos" style="font-size:14px"><%= p.position %></div>
      </div>
      <% if (p.foot) { %><div class="badge" style="background:#2a2a2e;color:#ff8a33"><%= p.foot %> foot</div><% } %>
    </div>
    <% if (p.photo) { %><img class="pf-photo" style="display:block;margin:10px auto;max-width:300px;width:100%" src="/uploads/<%= p.photo %>" alt="<%= p.name %>"><% } %>
    <div class="pf-name" style="text-align:center;font-size:28px"><%= p.name %></div>
    <div class="stats">
      <% if (p.age) { %><div class="stat"><b><%= p.age %></b><small>Age</small></div><% } %>
      <% if (p.height_cm) { %><div class="stat"><b><%= p.height_cm %></b><small>Height cm</small></div><% } %>
      <% if (p.weight_kg) { %><div class="stat"><b><%= p.weight_kg %></b><small>Weight kg</small></div><% } %>
    </div>
  </div>

  <div class="actions" style="margin-top:18px">
    <% if (L.wa) { %><a class="act main" href="<%= L.wa %>" target="_blank" rel="noopener">WhatsApp</a><% } %>
    <% if (L.tel) { %><a class="act" href="<%= L.tel %>">Call</a><% } %>
    <% if (L.ig) { %><a class="act" href="<%= L.ig %>" target="_blank" rel="noopener">Instagram</a><% } %>
    <% if (L.mail) { %><a class="act" href="<%= L.mail %>">Email</a><% } %>
    <% if (L.map) { %><a class="act" href="<%= L.map %>" target="_blank" rel="noopener">Location</a><% } %>
    <% if (L.cv) { %><a class="act" href="<%= L.cv %>" target="_blank">CV (PDF)</a><% } %>
  </div>

  <% if (L.yt) { %>
  <div class="card"><h2>Highlights</h2>
    <% if (embed) { %><div class="video"><iframe src="<%= embed %>" allowfullscreen></iframe></div><% } %>
    <a class="act" href="<%= L.yt %>" target="_blank" rel="noopener">Watch on YouTube</a></div>
  <% } %>
  <% if (lines(p.career).length) { %><div class="card"><h2>Playing Career</h2>
    <% lines(p.career).forEach(function(l) { %><p>• <%= l %></p><% }) %></div><% } %>
  <% if (lines(p.achievements).length) { %><div class="card"><h2>Achievements</h2>
    <% lines(p.achievements).forEach(function(l) { %><p>• <%= l %></p><% }) %></div><% } %>
  <% if (lines(p.strengths).length) { %><div class="card"><h2>Strengths</h2>
    <% lines(p.strengths).forEach(function(l) { %><p>• <%= l %></p><% }) %></div><% } %>
</div>
<%- include('footer') %>
